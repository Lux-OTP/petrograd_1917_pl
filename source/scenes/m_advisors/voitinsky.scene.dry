@organizing_
title: Organizacje Rady
subtitle: Wojtiński może pomóc w budowie instytucji administracyjnych Rady.
choose-if: advisor_action_timer = 0 and m_in_exco
unavailable-subtitle: [? if advisor_action_timer > 0 : Tygodnie do następnej akcji doradcy: [+ advisor_action_timer +]. ?] [? if not m_in_exco : Nie wchodzimy w skład Komitetu Wykonawczego Rady. ?]
on-arrival: advisor_action_timer = 4; organization_soviet_timer -= 4; last_advisor_action = 1
go-to: organization_soviet

@militias_
title: Milicje Robotnicze
subtitle: Rozbudowa struktur milicji robotniczych.
choose-if: advisor_action_timer = 0 and m_in_exco
unavailable-subtitle: [? if advisor_action_timer > 0 : Tygodnie do następnej akcji doradcy: [+ advisor_action_timer +]. ?] [? if not m_in_exco : Nie wchodzimy w skład Komitetu Wykonawczego Rady. ?]
on-arrival: advisor_action_timer = 4; militias_timer -= 4; last_advisor_action = 1
go-to: militias

@finance_
title: Polityka Fiskalna
subtitle: Wojtiński jest ministrem finansów.
choose-if: advisor_action_timer = 0 and finance_minister = "Voitinsky"
